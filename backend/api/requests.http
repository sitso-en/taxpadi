### TaxPadi API Requests
### Base URL: http://localhost:8080

@baseUrl = http://localhost:8080


### ============================================================
### GROUP 1 — AUTH
### ============================================================


### 1. Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "full_name": "Kwame Mensah",
  "phone": "+233201234567",
  "email": "kwame@example.com",
  "password": "Secret123!",
  "region": "Ashanti",
  "taxpayer_category": "INDIVIDUAL"
}


### 2. Verify OTP
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phone": "+233201234567",
  "otp_code": "123456",
  "purpose": "REGISTER"
}


### 3. Resend OTP
POST {{baseUrl}}/api/v1/auth/resend-otp
Content-Type: application/json

{
  "phone": "+233201234567",
  "purpose": "REGISTER"
}


### 4. Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "phone": "+233599744646",
  "password": "NewSecret456!",
  "device_info": "Bruno Test Client"
}


### 5. Refresh Token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "paste-refresh-token-from-login-response-here"
}


### 6. Logout
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json

{
  "refresh_token": "paste-refresh-token-from-login-response-here"
}


### 7. Register Biometric (requires Bearer token)
POST {{baseUrl}}/api/v1/auth/biometric/register
Content-Type: application/json
Authorization: Bearer paste-access-token-from-login-response-here

{
  "biometric_token": "test-biometric-token-abc123",
  "device_info": "Bruno Test Client"
}


### 8. Biometric Login
POST {{baseUrl}}/api/v1/auth/biometric/login
Content-Type: application/json

{
  "biometric_token": "test-biometric-token-abc123",
  "device_info": "Bruno Test Client"
}


### ============================================================
### GROUP 2 — PASSWORD
### ============================================================


### 1. Forgot Password
POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "phone": "+233599744646"
}


### 2. Verify Reset OTP
POST {{baseUrl}}/api/v1/auth/verify-reset-otp
Content-Type: application/json

{
  "phone": "+233599744646",
  "otp_code": "965842"
}


### 3. Reset Password
POST {{baseUrl}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "reset_token": "paste-reset-token-from-verify-reset-otp-response-here",
  "new_password": "NewSecret123!",
  "confirm_password": "NewSecret123!"
}


### ============================================================
### GROUP 3 — USER
### ============================================================


### 1. Get Profile
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjZjI5Yzc1ZS1kYTRjLTQyYjAtYTkwYS0yZDc5MjA0NTgzNjYiLCJqdGkiOiIxNWM2OWNmYi01OWIyLTRkODAtYmNlMS01YmY4M2U2Yjg0YjEiLCJwaG9uZSI6IisyMzM1OTk3NDQ2NDYiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc3ODY2NjM2MCwiZXhwIjoxNzc4NjY3MjYwfQ.-s5qqr2KqjHXkkI-buI3h553vaOI4H4io9FiioI1FWE


### 2. Update Profile
PUT {{baseUrl}}/api/v1/users/me
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjZjI5Yzc1ZS1kYTRjLTQyYjAtYTkwYS0yZDc5MjA0NTgzNjYiLCJqdGkiOiIxNWM2OWNmYi01OWIyLTRkODAtYmNlMS01YmY4M2U2Yjg0YjEiLCJwaG9uZSI6IisyMzM1OTk3NDQ2NDYiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc3ODY2NjM2MCwiZXhwIjoxNzc4NjY3MjYwfQ.-s5qqr2KqjHXkkI-buI3h553vaOI4H4io9FiioI1FWE

{
  "full_name": "Jermaine Lamarr Cole",
  "email": "jcole@gmail.com",
  "region": "Greater Accra",
  "tin": "12345678901"
}


### 3. Change Password
PUT {{baseUrl}}/api/v1/users/me/password
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjZjI5Yzc1ZS1kYTRjLTQyYjAtYTkwYS0yZDc5MjA0NTgzNjYiLCJqdGkiOiIxNWM2OWNmYi01OWIyLTRkODAtYmNlMS01YmY4M2U2Yjg0YjEiLCJwaG9uZSI6IisyMzM1OTk3NDQ2NDYiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc3ODY2NjM2MCwiZXhwIjoxNzc4NjY3MjYwfQ.-s5qqr2KqjHXkkI-buI3h553vaOI4H4io9FiioI1FWE

