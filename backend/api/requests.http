### TaxPadi API Requests
### Base URL: http://localhost:8080

@baseUrl = http://localhost:8080
@accessToken = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjZjI5Yzc1ZS1kYTRjLTQyYjAtYTkwYS0yZDc5MjA0NTgzNjYiLCJqdGkiOiIzYzVmMDU5My1kOTYxLTRlNDYtYWRjYi05YjVmZWRjZDU2ZDYiLCJwaG9uZSI6IisyMzM1OTk3NDQ2NDYiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc3OTE1MDA3MywiZXhwIjoxNzc5MTUwOTczfQ.Nxw_z1-6D76Px_lML5zBJbF6bAmmLBqBG0KWvTJmj7M
@refreshToken = paste-refresh-token-here
@profileId = paste-profile-id-here


### ============================================================
### GROUP 1 — AUTH
### ============================================================


### 1. Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "full_name": "Kwame Mensah",
  "phone": "+233201234567",
  "email": "kwame@example.com",
  "password": "Secret123!",
  "region": "Ashanti",
  "taxpayer_category": "INDIVIDUAL"
}


### 2. Verify OTP
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phone": "+233201234567",
  "otp_code": "123456",
  "purpose": "REGISTER"
}


### 3. Resend OTP
POST {{baseUrl}}/api/v1/auth/resend-otp
Content-Type: application/json

{
  "phone": "+233201234567",
  "purpose": "REGISTER"
}


### 4. Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "phone": "+233599744646",
  "password": "NewSecret456!",
  "device_info": "Bruno Test Client"
}


### 5. Refresh Token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}


### 6. Logout
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}


### 7. Register Biometric (requires Bearer token)
POST {{baseUrl}}/api/v1/auth/biometric/register
Content-Type: application/json
Authorization: Bearer paste-access-token-from-login-response-here

{
  "biometric_token": "test-biometric-token-abc123",
  "device_info": "Bruno Test Client"
}


### 8. Biometric Login
POST {{baseUrl}}/api/v1/auth/biometric/login
Content-Type: application/json

{
  "biometric_token": "test-biometric-token-abc123",
  "device_info": "Bruno Test Client"
}


### ============================================================
### GROUP 2 — PASSWORD
### ============================================================


### 1. Forgot Password
POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "phone": "+233599744646"
}


### 2. Verify Reset OTP
POST {{baseUrl}}/api/v1/auth/verify-reset-otp
Content-Type: application/json

{
  "phone": "+233599744646",
  "otp_code": "965842"
}


### 3. Reset Password
POST {{baseUrl}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "reset_token": "paste-reset-token-from-verify-reset-otp-response-here",
  "new_password": "NewSecret123!",
  "confirm_password": "NewSecret123!"
}


### ============================================================
### GROUP 3 — USER
### ============================================================


### 1. Get Profile
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}


### 2. Update Profile
PUT {{baseUrl}}/api/v1/users/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "full_name": "Jermaine Lamarr Cole",
  "email": "jcole@gmail.com",
  "region": "Greater Accra",
  "tin": "12345678901"
}


### 3. Change Password
PUT {{baseUrl}}/api/v1/users/me/password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "current_password": "Secret123!",
  "new_password": "NewSecret456!",
  "confirm_password": "NewSecret456!"
}



### 4. Deactivate Account
DELETE {{baseUrl}}/api/v1/users/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "password": "Secret123!",
  "reason": "No longer needed"
}


### 5. Get Health Score (placeholder — returns 404)
GET {{baseUrl}}/api/v1/users/me/health-score
Authorization: Bearer {{accessToken}}


### 6. Request Data Export
POST {{baseUrl}}/api/v1/users/me/data-request
Authorization: Bearer {{accessToken}}


### 7. Permanent Account Deletion
DELETE {{baseUrl}}/api/v1/users/me/permanent
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "password": "Secret123!",
  "confirmation": "DELETE MY ACCOUNT PERMANENTLY"
}

### ============================================================
### GROUP 4 — SESSIONS
### ============================================================


### 1. List Active Sessions
GET {{baseUrl}}/api/v1/users/me/sessions
Authorization: Bearer {{accessToken}}


### 2. Revoke Specific Session
DELETE {{baseUrl}}/api/v1/users/me/sessions/3436583a-e8e8-4dc7-b5c4-5a4bb7d27b3f
Authorization: Bearer {{accessToken}}


### 3. Revoke All Other Sessions
DELETE {{baseUrl}}/api/v1/users/me/sessions
Authorization: Bearer {{accessToken}}




### ============================================================
### GROUP 7 — MULTI-PROFILE
### ============================================================


### 1. Get All Profiles
GET {{baseUrl}}/api/v1/profiles
Authorization: Bearer {{accessToken}}


### 2. Create Profile
POST {{baseUrl}}/api/v1/profiles
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "label": "My Business",
  "taxpayer_category": "sole_trader",
  "tin": "C0012345678",
  "tax_year_start": "2024-01-01"
}


### 3. Update Profile
PUT {{baseUrl}}/api/v1/profiles/{{profileId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "label": "My Updated Business",
  "tax_year_start": "2024-01-01"
}


### 4. Delete Profile
DELETE {{baseUrl}}/api/v1/profiles/{{profileId}}
Authorization: Bearer {{accessToken}}


### 5. Switch Active Profile
PUT {{baseUrl}}/api/v1/profiles/{{profileId}}/switch
Authorization: Bearer {{accessToken}}


### ============================================================
### GROUP 9 — TAX CALCULATIONS
### ============================================================


### 1. Get Overall Tax Liability
GET {{baseUrl}}/api/v1/tax/liability
Authorization: Bearer {{accessToken}}


### 2. Get Tax Liability by Type — Income Tax (annual)
GET {{baseUrl}}/api/v1/tax/liability/income_tax
Authorization: Bearer {{accessToken}}


### 3. Get Tax Liability by Type — VAT (monthly)
GET {{baseUrl}}/api/v1/tax/liability/vat?year=2026&month=5
Authorization: Bearer {{accessToken}}


### 4. Get Tax Liability by Type — PAYE (monthly)
GET {{baseUrl}}/api/v1/tax/liability/paye?year=2026&month=5
Authorization: Bearer {{accessToken}}


### 5. Get Tax Liability by Type — Withholding
GET {{baseUrl}}/api/v1/tax/liability/withholding
Authorization: Bearer {{accessToken}}


### 6. Get Tax Liability History (all types)
GET {{baseUrl}}/api/v1/tax/liability/history
Authorization: Bearer {{accessToken}}


### 7. Get Tax Liability History (filtered by type)
GET {{baseUrl}}/api/v1/tax/liability/history?tax_type=income_tax&page=1&limit=12
Authorization: Bearer {{accessToken}}


### 8. Recalculate Tax Liability
POST {{baseUrl}}/api/v1/tax/liability/recalculate
Authorization: Bearer {{accessToken}}


### ============================================================                                                                                                                              
### GROUP 10 — TAX BRACKETS & RATES
### ============================================================                                                                                                                              
                                                                                                                                                                                            

### 1. Get Income Tax Brackets
GET {{baseUrl}}/api/v1/tax/brackets
Authorization: Bearer {{accessToken}}


### 2. Get All Tax Rates
GET {{baseUrl}}/api/v1/tax/rates
Authorization: Bearer {{accessToken}}


### ============================================================
### GROUP 11 — VAT
### ============================================================
### 1. Get VAT Status (current month)
GET {{baseUrl}}/api/v1/tax/vat/status
Authorization: Bearer {{accessToken}}


### 2. Get VAT Status (specific month)
GET {{baseUrl}}/api/v1/tax/vat/status?month=5&year=2026
Authorization: Bearer {{accessToken}}


### 3. Register VAT Record
POST {{baseUrl}}/api/v1/tax/vat/register
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "month": 5,
  "year": 2026,
  "total_sales": 50000.00,
  "total_purchases": 20000.00,
  "input_vat": 3000.00
}


### 4. Update VAT Record
PUT {{baseUrl}}/api/v1/tax/vat/2026/5
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "total_sales": 55000.00,
  "total_purchases": 22000.00,
  "input_vat": 3300.00
}


### 5. Get VAT History (all years)
GET {{baseUrl}}/api/v1/tax/vat/history
Authorization: Bearer {{accessToken}}


### 6. Get VAT History (filtered by year)
GET {{baseUrl}}/api/v1/tax/vat/history?year=2026
Authorization: Bearer {{accessToken}}


### ============================================================
### GROUP 12 — PAYE
### ============================================================

@employeeId = 4c725b5b-30d9-4605-9c3d-b863c9848e91
@payeRecordId = paste-paye-record-id-here


### 1. Get All Employees (active)
GET {{baseUrl}}/api/v1/tax/paye/employees
Authorization: Bearer {{accessToken}}


### 2. Get All Employees (all statuses)
GET {{baseUrl}}/api/v1/tax/paye/employees?status=all
Authorization: Bearer {{accessToken}}


### 3. Add Employee
POST {{baseUrl}}/api/v1/tax/paye/employees
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "full_name": "Smug Face",
  "position": "Data Analyst",
  "gross_salary": 35000.00,
  "transport_allowance": 3000.00,
  "housing_allowance": 5000.00,
  "other_allowances": 0.00,
  "social_security_no": "C0047829291",
  "start_date": "2026-01-01"
}


### 4. Get Single Employee
GET {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Authorization: Bearer {{accessToken}}


### 5. Update Employee
PUT {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "gross_salary": 40000.00,
  "transport_allowance": 3500.00
}


### 6. Deactivate Employee
DELETE {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "end_date": "2026-05-31"
}


### 7. Get PAYE Records (all)
GET {{baseUrl}}/api/v1/tax/paye/records
Authorization: Bearer {{accessToken}}


### 8. Get PAYE Records (filtered by month and year)
GET {{baseUrl}}/api/v1/tax/paye/records?month=5&year=2026
Authorization: Bearer {{accessToken}}


### 9. Get Monthly PAYE Summary
GET {{baseUrl}}/api/v1/tax/paye/records/5/2026
Authorization: Bearer {{accessToken}}


### 10. Mark PAYE Record as Remitted
PUT {{baseUrl}}/api/v1/tax/paye/records/{{payeRecordId}}/remit
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "remitted_at": "2026-05-15T10:00:00"
}


### 11. Get Annual PAYE Return
GET {{baseUrl}}/api/v1/tax/paye/annual-return/2026
Authorization: Bearer {{accessToken}}






### GROUP 13 — WITHHOLDING TAX


@whtTransactionId = paste-transaction-id-here


### 1. Get WHT Transactions (all)
GET {{baseUrl}}/api/v1/tax/withholding/transactions
Authorization: Bearer {{accessToken}}


### 2. Get WHT Transactions (unremitted only)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?remitted=false
Authorization: Bearer {{accessToken}}


### 3. Get WHT Transactions (filtered by category)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?category=contractor_payment
Authorization: Bearer {{accessToken}}


### 4. Get WHT Transactions (filtered by date range)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?date_from=2026-01-01&date_to=2026-05-31
Authorization: Bearer {{accessToken}}


### 5. Mark WHT Transaction as Remitted
PUT {{baseUrl}}/api/v1/tax/withholding/transactions/{{whtTransactionId}}/remit
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "remitted_at": "2026-05-15T10:00:00"
}


### 6. Mark WHT Transaction as Remitted (defaults to now)
PUT {{baseUrl}}/api/v1/tax/withholding/transactions/{{whtTransactionId}}/remit
Authorization: Bearer {{accessToken}}


### ============================================================
### GROUP 14 — TAX RETURNS
### ============================================================

@returnId = paste-return-id-here


### 1. Get All Tax Returns
GET {{baseUrl}}/api/v1/tax/returns
Authorization: Bearer {{accessToken}}


### 2. Get Tax Returns (filtered)
GET {{baseUrl}}/api/v1/tax/returns?tax_type=income_tax&status=draft&year=2026
Authorization: Bearer {{accessToken}}


### 3. Generate Tax Return — Income Tax
POST {{baseUrl}}/api/v1/tax/returns/generate
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "tax_type": "income_tax",
  "tax_year": 2026
}


### 4. Generate Tax Return — VAT (monthly)
POST {{baseUrl}}/api/v1/tax/returns/generate
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "tax_type": "vat",
  "tax_year": 2026,
  "month": 5
}


### 5. Generate Tax Return — PAYE (monthly)
POST {{baseUrl}}/api/v1/tax/returns/generate
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "tax_type": "paye",
  "tax_year": 2026,
  "month": 5
}


### 6. Get Single Tax Return
GET {{baseUrl}}/api/v1/tax/returns/{{returnId}}
Authorization: Bearer {{accessToken}}


### 7. Preview Tax Return
GET {{baseUrl}}/api/v1/tax/returns/{{returnId}}/preview
Authorization: Bearer {{accessToken}}


### 8. Submit Tax Return
PUT {{baseUrl}}/api/v1/tax/returns/{{returnId}}/submit
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "gra_reference": "GRA-2026-123456"
}


### 9. Submit Tax Return (no reference)
PUT {{baseUrl}}/api/v1/tax/returns/{{returnId}}/submit
Authorization: Bearer {{accessToken}}


### 10. Amend Rejected Tax Return
PUT {{baseUrl}}/api/v1/tax/returns/{{returnId}}/amend
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "amendment_reason": "Incorrect gross income figure. Corrected based on updated bank statement."
}


