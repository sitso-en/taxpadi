  "label": "My Updated Business",
  "tax_year_start": "2024-01-01"
}


### 4. Delete Profile
DELETE {{baseUrl}}/api/v1/profiles/{{profileId}}
Authorization: Bearer {{accessToken}}


### 5. Switch Active Profile
PUT {{baseUrl}}/api/v1/profiles/{{profileId}}/switch
Authorization: Bearer {{accessToken}}










### GROUP 9 — TAX CALCULATIONS
### 1. Get Overall Tax Liability
GET {{baseUrl}}/api/v1/tax/liability
Authorization: Bearer {{accessToken}}


### 2. Get Tax Liability by Type — Income Tax (annual)
GET {{baseUrl}}/api/v1/tax/liability/income_tax
Authorization: Bearer {{accessToken}}


### 3. Get Tax Liability by Type — VAT (monthly)
GET {{baseUrl}}/api/v1/tax/liability/vat?year=2026&month=5
Authorization: Bearer {{accessToken}}


### 4. Get Tax Liability by Type — PAYE (monthly)
GET {{baseUrl}}/api/v1/tax/liability/paye?year=2026&month=5
Authorization: Bearer {{accessToken}}


### 5. Get Tax Liability by Type — Withholding
GET {{baseUrl}}/api/v1/tax/liability/withholding
Authorization: Bearer {{accessToken}}


### 6. Get Tax Liability History (all types)
GET {{baseUrl}}/api/v1/tax/liability/history
Authorization: Bearer {{accessToken}}


### 7. Get Tax Liability History (filtered by type)
GET {{baseUrl}}/api/v1/tax/liability/history?tax_type=income_tax&page=1&limit=12
Authorization: Bearer {{accessToken}}


### 8. Recalculate Tax Liability
POST {{baseUrl}}/api/v1/tax/liability/recalculate
Authorization: Bearer {{accessToken}}









### GROUP 10 — TAX BRACKETS & RATES                                                                                                                                                                            
### 1. Get Income Tax Brackets
GET {{baseUrl}}/api/v1/tax/brackets
Authorization: Bearer {{accessToken}}


### 2. Get All Tax Rates
GET {{baseUrl}}/api/v1/tax/rates
Authorization: Bearer {{accessToken}}









### GROUP 11 — VAT
### 1. Get VAT Status (current month)
GET {{baseUrl}}/api/v1/tax/vat/status
Authorization: Bearer {{accessToken}}


### 2. Get VAT Status (specific month)
GET {{baseUrl}}/api/v1/tax/vat/status?month=5&year=2026
Authorization: Bearer {{accessToken}}


### 3. Register VAT Record
POST {{baseUrl}}/api/v1/tax/vat/register
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "month": 5,
  "year": 2026,
  "total_sales": 50000.00,
  "total_purchases": 20000.00,
  "input_vat": 3000.00
}


### 4. Update VAT Record
PUT {{baseUrl}}/api/v1/tax/vat/2026/5
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "total_sales": 55000.00,
  "total_purchases": 22000.00,
  "input_vat": 3300.00
}


### 5. Get VAT History (all years)
GET {{baseUrl}}/api/v1/tax/vat/history
Authorization: Bearer {{accessToken}}


### 6. Get VAT History (filtered by year)
GET {{baseUrl}}/api/v1/tax/vat/history?year=2026
Authorization: Bearer {{accessToken}}









### GROUP 12 — PAYE
@employeeId = 4c725b5b-30d9-4605-9c3d-b863c9848e91
@payeRecordId = paste-paye-record-id-here


### 1. Get All Employees (active)
GET {{baseUrl}}/api/v1/tax/paye/employees
Authorization: Bearer {{accessToken}}


### 2. Get All Employees (all statuses)
GET {{baseUrl}}/api/v1/tax/paye/employees?status=all
Authorization: Bearer {{accessToken}}


### 3. Add Employee
POST {{baseUrl}}/api/v1/tax/paye/employees
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "full_name": "Smug Face",
  "position": "Data Analyst",
  "gross_salary": 35000.00,
  "transport_allowance": 3000.00,
  "housing_allowance": 5000.00,
  "other_allowances": 0.00,
  "social_security_no": "C0047829291",
  "start_date": "2026-01-01"
}


### 4. Get Single Employee
GET {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Authorization: Bearer {{accessToken}}


### 5. Update Employee
PUT {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "gross_salary": 40000.00,
  "transport_allowance": 3500.00
}


### 6. Deactivate Employee
DELETE {{baseUrl}}/api/v1/tax/paye/employees/{{employeeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "end_date": "2026-05-31"
}


### 7. Get PAYE Records (all)
GET {{baseUrl}}/api/v1/tax/paye/records
Authorization: Bearer {{accessToken}}


### 8. Get PAYE Records (filtered by month and year)
GET {{baseUrl}}/api/v1/tax/paye/records?month=5&year=2026
Authorization: Bearer {{accessToken}}


### 9. Get Monthly PAYE Summary
GET {{baseUrl}}/api/v1/tax/paye/records/5/2026
Authorization: Bearer {{accessToken}}


### 10. Mark PAYE Record as Remitted
PUT {{baseUrl}}/api/v1/tax/paye/records/{{payeRecordId}}/remit
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "remitted_at": "2026-05-15T10:00:00"
}


### 11. Get Annual PAYE Return
GET {{baseUrl}}/api/v1/tax/paye/annual-return/2026
Authorization: Bearer {{accessToken}}









### GROUP 13 — WITHHOLDING TAX
@whtTransactionId = paste-transaction-id-here


### 1. Get WHT Transactions (all)
GET {{baseUrl}}/api/v1/tax/withholding/transactions
Authorization: Bearer {{accessToken}}


### 2. Get WHT Transactions (unremitted only)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?remitted=false
Authorization: Bearer {{accessToken}}


### 3. Get WHT Transactions (filtered by category)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?category=contractor_payment
Authorization: Bearer {{accessToken}}


### 4. Get WHT Transactions (filtered by date range)
GET {{baseUrl}}/api/v1/tax/withholding/transactions?date_from=2026-01-01&date_to=2026-05-31
Authorization: Bearer {{accessToken}}


### 5. Mark WHT Transaction as Remitted
PUT {{baseUrl}}/api/v1/tax/withholding/transactions/{{whtTransactionId}}/remit
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "remitted_at": "2026-05-15T10:00:00"
}


### 6. Mark WHT Transaction as Remitted (defaults to now)
PUT {{baseUrl}}/api/v1/tax/withholding/transactions/{{whtTransactionId}}/remit
Authorization: Bearer {{accessToken}}









### GROUP 14 — TAX RETURNS
### 1. Get All Tax Returns
GET {{baseUrl}}/api/v1/tax/returns
