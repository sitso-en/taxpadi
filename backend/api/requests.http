  "current_password": "Secret123!",
  "new_password": "NewSecret456!",
  "confirm_password": "NewSecret456!"
}


### 4. Deactivate Account
DELETE {{baseUrl}}/api/v1/users/me
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJjZjI5Yzc1ZS1kYTRjLTQyYjAtYTkwYS0yZDc5MjA0NTgzNjYiLCJqdGkiOiIxNWM2OWNmYi01OWIyLTRkODAtYmNlMS01YmY4M2U2Yjg0YjEiLCJwaG9uZSI6IisyMzM1OTk3NDQ2NDYiLCJyb2xlIjoiVVNFUiIsImlhdCI6MTc3ODY2NjM2MCwiZXhwIjoxNzc4NjY3MjYwfQ.-s5qqr2KqjHXkkI-buI3h553vaOI4H4io9FiioI1FWE

{
  "password": "Secret123!",
  "reason": "No longer needed"
}


