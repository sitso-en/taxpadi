###############################################
### Group 17 — Payments
###############################################

### 1. Get payment history
GET {{baseUrl}}/api/v1/payments?page=1
Authorization: Bearer {{accessToken}}

### 2. Get payment history (filtered by status)
GET {{baseUrl}}/api/v1/payments?status=successful&page=1
Authorization: Bearer {{accessToken}}

### 3. Initiate payment for a tax return (MoMo)
POST {{baseUrl}}/api/v1/payments/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "return_id": "{{returnId}}",
  "amount": 250.00,
  "payment_method": "momo",
  "momo_number": "+233501234567",
  "momo_provider": "mtn"
}

### 4. Initiate payment for a penalty (MoMo)
POST {{baseUrl}}/api/v1/payments/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "penalty_id": "{{penaltyId}}",
  "amount": 200.00,
  "payment_method": "momo",
  "momo_number": "+233501234567",
  "momo_provider": "mtn"
}

### 5. Get payment by ID
GET {{baseUrl}}/api/v1/payments/{{paymentId}}
Authorization: Bearer {{accessToken}}

### 6. Confirm payment (successful)
POST {{baseUrl}}/api/v1/payments/{{paymentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "payment_reference": "MOMO-REF-ABC123456",
  "status": "successful"
}

### 7. Confirm payment (failed)
POST {{baseUrl}}/api/v1/payments/{{paymentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "payment_reference": "MOMO-REF-ABC123456",
  "status": "failed"
}

### 8. Get payment status
GET {{baseUrl}}/api/v1/payments/{{paymentId}}/status
Authorization: Bearer {{accessToken}}

### 9. Get payment certificate
GET {{baseUrl}}/api/v1/payments/{{paymentId}}/certificate
Authorization: Bearer {{accessToken}}

######################################
# Group 8 — Transactions (scan/voice)
######################################

### Scan receipt (POST /transactions/scan)
POST {{baseUrl}}/api/v1/transactions/scan
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="image"; filename="receipt.jpg"
Content-Type: image/jpeg

< ./test-receipt.jpg
--boundary
Content-Disposition: form-data; name="transaction_type"

expense
--boundary--

### Voice transaction (POST /transactions/voice)
POST {{baseUrl}}/api/v1/transactions/voice
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="audio"; filename="transaction.mp3"
Content-Type: audio/mpeg

< ./test-audio.mp3
--boundary
Content-Disposition: form-data; name="language"

en
--boundary--
